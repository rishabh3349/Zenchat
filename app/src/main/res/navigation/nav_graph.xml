<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/signInFragment">

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.example.zenchat.ui.Login.signIn.SignInFragment"
        android:label="Login">

        <action
            android:id="@+id/action_signIn_to_signup"
            app:destination="@id/signUpFragment" />

        <action
            android:id="@+id/action_signIn_to_forgot"
            app:destination="@id/forgotPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.zenchat.ui.Login.signUp.SignUpFragment"
        android:label="Sign Up" >
        <action
            android:id="@+id/action_signUp_to_signIn"
            app:destination="@id/signInFragment" />

    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.example.zenchat.ui.Login.forgotPassword.ForgotPasswordFragment"
        android:label="Forgot Password" >
        <action
            android:id="@+id/action_forgot_to_signIn"
            app:destination="@id/signInFragment" />
    </fragment>

</navigation>
